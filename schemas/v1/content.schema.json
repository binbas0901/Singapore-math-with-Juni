{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Juni DATA-001 draft v1",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/lesson"
    },
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/submission"
    }
  ],
  "$defs": {
    "bounds": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "objective": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "item": {
          "type": "string",
          "minLength": 1
        },
        "strand": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "sourceId",
        "page",
        "item",
        "strand",
        "topic",
        "description"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "objectiveId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "conceptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "enum": [
            "core",
            "enrichment"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "representations": {
          "type": "array",
          "items": {
            "enum": [
              "counters",
              "drawing",
              "accessibleMarking",
              "numberBond",
              "numeral"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "objectiveId",
        "conceptId",
        "description",
        "classification",
        "bounds",
        "representations"
      ],
      "additionalProperties": false
    },
    "dependency": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "advisory"
            },
            "beforeLessonId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "afterLessonId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "beforeLessonId",
            "afterLessonId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "readiness"
            },
            "forTargetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "probeTargetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "quantities": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "representations": {
              "type": "array",
              "items": {
                "enum": [
                  "counters",
                  "drawing",
                  "accessibleMarking",
                  "numberBond",
                  "numeral"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "kind",
            "forTargetId",
            "probeTargetId",
            "quantities",
            "representations"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "componentMastery"
            },
            "forTargetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "componentTargetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "evidence": {
              "const": "priorOrConcurrentIndependent"
            }
          },
          "required": [
            "kind",
            "forTargetId",
            "componentTargetId",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "catalog"
        },
        "unitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "track": {
          "enum": [
            "common",
            "foundation"
          ]
        },
        "lessonSlots": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "objectives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objective"
          },
          "minItems": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target"
          },
          "minItems": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          },
          "minItems": 0
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "unitId",
        "level",
        "track",
        "lessonSlots",
        "objectives",
        "targets",
        "dependencies"
      ],
      "additionalProperties": false
    },
    "workspace": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "tool": {
          "const": "countersAndBond"
        },
        "whole": {
          "type": "integer",
          "minimum": 0
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "counters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "regionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              }
            },
            "required": [
              "id",
              "regionId"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "inputModes": {
          "type": "array",
          "items": {
            "enum": [
              "drag",
              "tapSelectPlace",
              "accessibleAction"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "legalActions": {
          "type": "array",
          "items": {
            "enum": [
              "moveCounter",
              "linkBond",
              "clearBond"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "tool",
        "whole",
        "regions",
        "counters",
        "inputModes",
        "legalActions"
      ],
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "moveCounter"
            },
            "counterId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "fromRegionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "toRegionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "counterId",
            "fromRegionId",
            "toRegionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "linkBond"
            },
            "partARegionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "partBRegionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "whole": {
              "type": "integer",
              "minimum": 0
            },
            "partA": {
              "type": "integer",
              "minimum": 0
            },
            "partB": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "partARegionId",
            "partBRegionId",
            "whole",
            "partA",
            "partB"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "clearBond"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "presentation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "highlight"
            },
            "regionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "regionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "hand"
            },
            "pose": {
              "enum": [
                "point",
                "contact",
                "move",
                "release"
              ]
            },
            "regionId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "pose",
            "regionId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "caption"
            },
            "chapterId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            }
          },
          "required": [
            "kind",
            "chapterId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "timeline": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "clipId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "clipVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "timebase": {
          "const": "ms"
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "atMs",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "atMs": {
                "type": "integer",
                "minimum": 0
              },
              "order": {
                "type": "integer",
                "minimum": 0
              },
              "payload": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "math"
                      },
                      "action": {
                        "$ref": "#/$defs/action"
                      }
                    },
                    "required": [
                      "kind",
                      "action"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "const": "presentation"
                      },
                      "update": {
                        "$ref": "#/$defs/presentation"
                      }
                    },
                    "required": [
                      "kind",
                      "update"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "atMs",
              "order",
              "payload"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "version",
        "clipId",
        "clipVersion",
        "timebase",
        "chapters",
        "cues"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "targetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "familyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "familyVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "exposureKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "demandId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "whole": {
          "type": "integer",
          "minimum": 0
        },
        "knownPart": {
          "type": "integer",
          "minimum": 0
        },
        "expectedAnswer": {
          "type": "integer",
          "minimum": 0
        },
        "acceptableAnswers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "difficulty": {
          "enum": [
            "introductory",
            "practice",
            "check"
          ]
        },
        "modelRequirement": {
          "const": "wholeAndBothParts"
        },
        "modelOptions": {
          "type": "array",
          "items": {
            "enum": [
              "counters",
              "drawing",
              "accessibleMarking",
              "numberBond",
              "numeral"
            ]
          },
          "minItems": 1
        },
        "responseKind": {
          "const": "nonnegativeInteger"
        }
      },
      "required": [
        "id",
        "version",
        "targetId",
        "familyId",
        "familyVersion",
        "exposureKey",
        "demandId",
        "prompt",
        "whole",
        "knownPart",
        "expectedAnswer",
        "acceptableAnswers",
        "explanation",
        "difficulty",
        "modelRequirement",
        "modelOptions",
        "responseKind"
      ],
      "additionalProperties": false
    },
    "assistance": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "stage": {
          "enum": [
            "neutralRetry",
            "representationHint",
            "guidedAction",
            "reteach"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "generic"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "reviewedMisconception"
                },
                "code": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "reviewRef": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "code",
                "reviewRef"
              ],
              "additionalProperties": false
            }
          ]
        },
        "disclosureIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "stage",
        "text",
        "branch",
        "disclosureIds"
      ],
      "additionalProperties": false
    },
    "disclosure": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "exposureKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "visual",
              "audio",
              "caption",
              "manual",
              "feedback"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reason": {
          "enum": [
            "workedExample",
            "taskHint",
            "guidedAction",
            "solutionFeedback"
          ]
        }
      },
      "required": [
        "id",
        "exposureKeys",
        "channels",
        "reason"
      ],
      "additionalProperties": false
    },
    "activity": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "kind": {
              "const": "readiness"
            },
            "targetIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "quantities": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "prompt": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "kind",
            "targetIds",
            "quantities",
            "prompt"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "kind": {
              "const": "observe"
            },
            "itemId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "workspaceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "timeline": {
              "$ref": "#/$defs/timeline"
            },
            "disclosureIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "kind",
            "itemId",
            "workspaceId",
            "timeline",
            "disclosureIds"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "kind": {
              "const": "guidedPractice"
            },
            "itemId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "workspaceId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "worksheetId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "assistanceIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "minItems": 0,
              "uniqueItems": true
            },
            "disclosureIds": {
              "type": "array",
              "items": {
